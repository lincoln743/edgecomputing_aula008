{
  "version": 1,
  "author": "FIAP - Edge Computing - Aula 08 - Interrupcoes",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 180, "left": -160, "attrs": { "color": "green", "label": "BOTAO" } },
    { "type": "wokwi-rgb-led", "id": "rgb1", "top": -110, "left": -150, "attrs": { "common": "cathode" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -30, "left": -110, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 10, "left": -110, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 50, "left": -110, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 120, "left": 230, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "btn1:1.l", "esp:15", "blue", [ "v0" ] ],
    [ "btn1:2.l", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:25", "r1:1", "red", [ "h0" ] ],
    [ "r1:2", "rgb1:R", "red", [ "v0" ] ],
    [ "esp:26", "r2:1", "green", [ "h0" ] ],
    [ "r2:2", "rgb1:G", "green", [ "v0" ] ],
    [ "esp:27", "r3:1", "blue", [ "h0" ] ],
    [ "r3:2", "rgb1:B", "blue", [ "v0" ] ],
    [ "rgb1:COM", "esp:GND.2", "black", [ "v0" ] ],

    [ "bz1:2", "esp:23", "purple", [ "v0" ] ],
    [ "bz1:1", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "serialMonitor": {
    "display": "always",
    "collapse": false,
    "convertEol": true,
    "newline": "lf"
  },
  "dependencies": {}
}
